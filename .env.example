# Copy this file to `.env` (already gitignored - never commit real credentials) and fill in
# your own values. `flasher configure` reads HOME_ASSISTANT_URL/HOME_ASSISTANT_TOKEN/SSID_NAME/
# SSID_PASSWORD to auto-provision a freshly flashed device, skipping the on-device WiFi/Home
# Assistant setup screens entirely. `firmware/build.rs` reads BUNDLED_CA_PATH at build time
# (everything else here is only ever used by the on-device setup flow or by `flasher configure`,
# never baked into the firmware binary itself).

HOME_ASSISTANT_URL="https://homeassistant.local:8123"
HOME_ASSISTANT_TOKEN="a long-lived access token from your HA profile page"

SSID_NAME="Your WiFi name"
SSID_PASSWORD="Your WiFi password"

# Optional: path to a PEM file (relative to the repo root, or absolute) containing an extra
# trusted CA certificate to embed into the firmware build. Used for local networks where HA's
# hostname resolves to a certificate signed by a private CA (e.g. a UniFi/UDM controller's own
# local CA) rather than a public one - see firmware/src/ha/rest.rs. Leave blank/unset if not needed.
BUNDLED_CA_PATH=
